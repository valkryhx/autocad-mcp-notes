# AutoCAD 中间产物与本地环境
*.bak
*.bak[0-9]
*.dwl
*.dwl2
*.sv$
*.tmp

# 调试脚本与临时输出（本项目只收录文档与成品）
draw_test/*.py
draw_test/*.png
draw_test/*.txt
draw_test/*.json
draw_test/*.scr
draw_test/*.dxf
draw_test/*.dwg
draw_test/*.pdf
draw_test/**/

# 例外：文字交叠检查的验收夹具与脚本。
# `tools/text_overlap/tests_overlap.py` 会读 merged_table.dxf（缺了它测试直接失败），
# `skills/.../references/verification.md` 让人 cd 进去跑那四个脚本，
# 而 com_mtext_bb.csv / anchors_bb.csv 是 AutoCAD 的实测基准——没有 AutoCAD 就再生不了，
# 它们是 accuracy.md 里每一个精度数字的出处。被排除的目录 git 不会进去，
# 所以子目录要先解禁，再挑文件。
!draw_test/overlap_proto/
!draw_test/overlap_proto/*.py
!draw_test/overlap_proto/verify/
draw_test/overlap_proto/verify/mleader2.dxf
draw_test/overlap_proto/verify/dim_textbox.txt
draw_test/overlap_proto/verify/probe_out.dxf

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 内容为空的占位文件
bug.md

# 文字交叠检查的测试夹具：ezdxf 1.4.4 没有 table API，也拒绝复制 ACAD_TABLE
# （CopyNotSupported），造不出真实表格和标注的样本，所以这份图不可替代。
!draw_test/123_check.dxf
